<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Paket 12 and later only ship as a .NET tool. This paket.exe takes the place of the merged one
    in the releases and in tools/ of the Paket package, so that the bootstrappers older than 11.0,
    which always download the latest release, explain how to move on instead of failing on a
    missing file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net461</TargetFramework>
    <AssemblyName>paket</AssemblyName>
    <ApplicationIcon>..\Paket\paket.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
