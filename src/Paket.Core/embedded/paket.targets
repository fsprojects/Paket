<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- Enable the restore command to run before builds -->
    <RestorePackages Condition=" '$(RestorePackages)' == '' ">true</RestorePackages>
    <MSBuildSupportsHashing>false</MSBuildSupportsHashing>
    <PaketToolsPath>$(MSBuildThisFileDirectory)</PaketToolsPath>
    <PaketRootPath>$(MSBuildThisFileDirectory)..\</PaketRootPath>
    <PaketLockFilePath>$(PaketRootPath)paket.lock</PaketLockFilePath>
    <PaketRestoreCacheFile>$(PaketRootPath)paket-files\paket.restore.cached</PaketRestoreCacheFile>

    <!-- Disable test for CLI tool completely - overrideable via properties in projects or via environment variables -->
    <PaketDisableCliTest Condition=" '$(PaketDisableCliTest)' == '' ">False</PaketDisableCliTest>
  </PropertyGroup>

  <!-- MSBuild 14 (VS 2015) has no MSBuildVersion, and comparing its empty value as a version fails (MSB4086): compare it only from MSBuild 15 -->
  <PropertyGroup Condition=" '$(MSBuildVersion)' != '' ">
    <MSBuildSupportsHashing Condition=" '$(MSBuildVersion)' &gt; '15.8.0' ">true</MSBuildSupportsHashing>
  </PropertyGroup>

  <!-- Resolve how paket should be called -->
  <!-- Current priority is: local tool, when the tool manifest declares paket => tool installed with tool-path (1: repo root, 2: .paket folder) => 3: local tool found by running 'dotnet paket' => 4: global path variable -->
  <!-- A paket installed with tool-path is skipped, with the warning PAKET0001, when the tool manifest declares paket: it can be an older Paket, such as the paket.exe or bootstrapper of Paket 11. -->
  <Target Name="SetPaketCommand" >
    <!-- Is CLI configured to be used in the closest "dotnet-tools.json" or ".config/dotnet-tools.json" from the root up? - can result in a false negative, which the 'dotnet paket' test below can make up for. -->
    <!-- Only the "paket" tool counts, as in #r "paket:". Unlike dotnet and #r "paket:", only the closest manifest of each name is read, and an "isRoot" one doesn't stop the lookup: MSBuild can't loop. -->
    <!-- So the outcome is a false positive when dotnet stops at an "isRoot" manifest without paket before it gets to the closest one of the other name, in the same folder or above, which declares paket. -->
    <PropertyGroup>
      <_PaketFullRootPath>$([System.IO.Path]::GetFullPath('$(PaketRootPath)'))</_PaketFullRootPath>
      <_DotnetToolsJsonDir>$([MSBuild]::GetDirectoryNameOfFileAbove('$(_PaketFullRootPath)', '.config/dotnet-tools.json'))</_DotnetToolsJsonDir>
      <_DotnetToolsJson Condition=" '$(_DotnetToolsJsonDir)' != '' ">$([System.IO.File]::ReadAllText("$(_DotnetToolsJsonDir)/.config/dotnet-tools.json"))</_DotnetToolsJson>
      <_RootDotnetToolsJsonDir>$([MSBuild]::GetDirectoryNameOfFileAbove('$(_PaketFullRootPath)', 'dotnet-tools.json'))</_RootDotnetToolsJsonDir>
      <_DotnetToolsJson Condition=" '$(_RootDotnetToolsJsonDir)' != '' ">$(_DotnetToolsJson)$([System.IO.File]::ReadAllText("$(_RootDotnetToolsJsonDir)/dotnet-tools.json"))</_DotnetToolsJson>
      <_ConfigContainsPaket Condition=" '$(_DotnetToolsJson)' != ''">$([System.Text.RegularExpressions.Regex]::IsMatch(`$(_DotnetToolsJson)`, `(?i)"paket"\s*:\s*\{`))</_ConfigContainsPaket>
      <_ConfigContainsPaket Condition=" '$(_ConfigContainsPaket)' == ''">false</_ConfigContainsPaket>
    </PropertyGroup>

    <!-- Test if paket is installed with tool-path in the standard locations. If so, it runs, unless the tool manifest declares paket. -->
    <PropertyGroup Condition=" '$(PaketExePath)' == '' ">
      <_PaketToolPathExeName Condition=" '$(OS)' != 'Windows_NT' ">paket</_PaketToolPathExeName>
      <_PaketToolPathExeName Condition=" '$(OS)' == 'Windows_NT' ">paket.exe</_PaketToolPathExeName>
      <_PaketToolPathExe Condition=" Exists('$(PaketRootPath)$(_PaketToolPathExeName)') ">$(PaketRootPath)$(_PaketToolPathExeName)</_PaketToolPathExe>
      <_PaketToolPathExe Condition=" '$(_PaketToolPathExe)' == '' AND Exists('$(PaketToolsPath)$(_PaketToolPathExeName)') ">$(PaketToolsPath)$(_PaketToolPathExeName)</_PaketToolPathExe>
      <PaketExePath Condition=" '$(_PaketToolPathExe)' != '' AND !$(_ConfigContainsPaket) ">$(_PaketToolPathExe)</PaketExePath>
    </PropertyGroup>
    <Warning Condition=" '$(PaketExePath)' == '' AND '$(_PaketToolPathExe)' != '' " Code="PAKET0001" Text="Ignoring $(_PaketToolPathExe): the tool manifest declares paket, which runs instead. Delete it if it is an older Paket, such as the paket.exe or bootstrapper of Paket 11, or add PAKET0001 to NoWarn." />

    <!-- Second test: Call 'dotnet paket' and see if it returns without an error. Mute all the output. Only run if previous test failed and the test has not been disabled. -->
    <!-- WARNING: This method can lead to processes hanging forever, and should be used as little as possible. See https://github.com/fsprojects/Paket/issues/3705 for details. -->
    <Exec Condition=" '$(PaketExePath)' == '' AND !$(PaketDisableCliTest) AND !$(_ConfigContainsPaket)" Command="dotnet paket --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" >
      <Output TaskParameter="ExitCode" PropertyName="LocalPaketToolExitCode" />
    </Exec>

    <!-- If paket is installed as CLI use that. Again, only if paket haven't already been found in standard locations. -->
    <PropertyGroup Condition=" '$(PaketExePath)' == '' AND ($(_ConfigContainsPaket) OR '$(LocalPaketToolExitCode)' == '0') ">
      <_PaketCommand>dotnet paket</_PaketCommand>
    </PropertyGroup>

    <!-- If neither local files nor CLI tool can be found, use the global path, where a global tool is. -->
    <PropertyGroup Condition=" '$(PaketExePath)' == '' AND '$(_PaketCommand)' == '' ">
      <PaketExePath>paket</PaketExePath>
    </PropertyGroup>

    <!-- If not using CLI, setup correct execution command. -->
    <PropertyGroup Condition=" '$(_PaketCommand)' == '' ">
      <_PaketExeExtension>$([System.IO.Path]::GetExtension("$(PaketExePath)"))</_PaketExeExtension>
      <_PaketCommand Condition=" '$(_PaketCommand)' == '' AND '$(_PaketExeExtension)' == '.dll' ">dotnet "$(PaketExePath)"</_PaketCommand>
      <_PaketCommand Condition=" '$(_PaketCommand)' == '' ">"$(PaketExePath)"</_PaketCommand>
    </PropertyGroup>

    <!-- The way to get a property to be available outside the target is to use this task. -->
    <CreateProperty Value="$(_PaketCommand)">
      <Output TaskParameter="Value" PropertyName="PaketCommand"/>
    </CreateProperty>

  </Target>

  <Choose> <!-- MyProject.fsproj.paket.references has the highest precedence -->
    <When Condition="Exists('$(MSBuildProjectFullPath).paket.references')">
      <PropertyGroup>
        <PaketReferences>$(MSBuildProjectFullPath).paket.references</PaketReferences>
      </PropertyGroup>
    </When> <!-- MyProject.paket.references -->
    <When Condition="Exists('$(MSBuildProjectDirectory)\$(MSBuildProjectName).paket.references')">
      <PropertyGroup>
        <PaketReferences>$(MSBuildProjectDirectory)\$(MSBuildProjectName).paket.references</PaketReferences>
      </PropertyGroup>
    </When> <!-- paket.references -->
    <When Condition="Exists('$(MSBuildProjectDirectory)\paket.references')">
      <PropertyGroup>
        <PaketReferences>$(MSBuildProjectDirectory)\paket.references</PaketReferences>
      </PropertyGroup>
    </When> <!-- Set to empty if a reference file isn't found matching one of the 3 format options -->
    <Otherwise>
      <PropertyGroup>
        <PaketReferences></PaketReferences>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <PropertyGroup>
    <!-- We need to ensure packages are restored prior to assembly resolve -->
    <BuildDependsOn Condition="$(RestorePackages) == 'true'">RestorePackages; $(BuildDependsOn);</BuildDependsOn>
  </PropertyGroup>

  <!-- Official workaround for https://docs.microsoft.com/en-us/visualstudio/msbuild/getfilehash-task?view=vs-2019 -->
  <UsingTask TaskName="Microsoft.Build.Tasks.GetFileHash" AssemblyName="Microsoft.Build.Tasks.Core, Version=15.1.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" Condition=" '$(MSBuildSupportsHashing)' == 'true' And '$(MSBuildVersion)' &lt; '16.0.360' " />
  <Target Name="RestorePackages" DependsOnTargets="SetPaketCommand">

    <PropertyGroup>
      <!-- Commands -->
      <RestoreCommand>$(PaketCommand) restore --references-file "$(PaketReferences)"</RestoreCommand>
      <PaketRestoreRequired>true</PaketRestoreRequired>
      <!-- before the cache is read: the restore of another project of a parallel build marks the cache stale before it creates the folder -->
      <_PaketPackagesFolderExists>false</_PaketPackagesFolderExists>
      <_PaketPackagesFolderExists Condition=" Exists('$(PaketRootPath)packages') ">true</_PaketPackagesFolderExists>
      <CacheFilesExist>false</CacheFilesExist>
      <CacheFilesExist Condition=" Exists('$(PaketRestoreCacheFile)') And Exists('$(PaketLockFilePath)') ">true</CacheFilesExist>
    </PropertyGroup>

    <!-- Skip the restore when the last full restore was of this paket.lock: paket.restore.cached holds the hashes of its content -->
    <GetFileHash Condition=" '$(MSBuildSupportsHashing)' == 'true' And '$(CacheFilesExist)' == 'true' " Files="$(PaketLockFilePath)" Algorithm="SHA256" HashEncoding="hex" >
      <Output TaskParameter="Hash" PropertyName="PaketRestoreLockFileHash" />
    </GetFileHash>
    <!-- Read the hashes of the cache, which is json, but a very simple key value object, as Paket.Restore.targets does -->
    <PropertyGroup Condition=" '$(MSBuildSupportsHashing)' == 'true' And '$(CacheFilesExist)' == 'true' ">
      <PaketRestoreCachedContents>$([System.IO.File]::ReadAllText('$(PaketRestoreCacheFile)'))</PaketRestoreCachedContents>
    </PropertyGroup>
    <ItemGroup Condition=" '$(MSBuildSupportsHashing)' == 'true' And '$(CacheFilesExist)' == 'true' ">
      <PaketRestoreCachedSplitObject Include="$([System.Text.RegularExpressions.Regex]::Split(`$(PaketRestoreCachedContents)`, `{|}|,`))"></PaketRestoreCachedSplitObject>
      <PaketRestoreCachedKeyValue Include="@(PaketRestoreCachedSplitObject)"
        Condition=" $([System.Text.RegularExpressions.Regex]::Split(`%(Identity)`, `&quot;: &quot;`).Length) &gt; 1 ">
        <Key>$([System.Text.RegularExpressions.Regex]::Split(`%(Identity)`, `": "`)[0].Replace(`"`, ``).Replace(` `, ``))</Key>
        <Value>$([System.Text.RegularExpressions.Regex]::Split(`%(Identity)`, `": "`)[1].Replace(`"`, ``).Replace(` `, ``))</Value>
      </PaketRestoreCachedKeyValue>
    </ItemGroup>
    <PropertyGroup Condition=" '$(MSBuildSupportsHashing)' == 'true' And '$(CacheFilesExist)' == 'true' ">
      <PackagesDownloadedHash Condition=" '%(PaketRestoreCachedKeyValue.Key)' == 'packagesDownloadedHash' ">%(PaketRestoreCachedKeyValue.Value)</PackagesDownloadedHash>
      <ProjectsRestoredHash Condition=" '%(PaketRestoreCachedKeyValue.Key)' == 'projectsRestoredHash' ">%(PaketRestoreCachedKeyValue.Value)</ProjectsRestoredHash>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(MSBuildSupportsHashing)' == 'true' And '$(CacheFilesExist)' == 'true' ">
      <!-- both hashes, as paket restore checks: a restore that can change the packages folder, like the one of this target, clears packagesDownloadedHash first -->
      <PaketRestoreRequired Condition=" '$(PaketRestoreLockFileHash)' != '' And '$(PaketRestoreLockFileHash)' == '$(ProjectsRestoredHash)' And '$(PaketRestoreLockFileHash)' == '$(PackagesDownloadedHash)' ">false</PaketRestoreRequired>
      <!-- a restore with paket.local doesn't write the cache, which can still be the one of a restore without it -->
      <PaketRestoreRequired Condition=" Exists('$(PaketRootPath)paket.local') ">true</PaketRestoreRequired>
      <!-- the cache doesn't know that the packages folder was deleted, which a group without "STORAGE: NONE" uses, as does a package of its own "storage: packages" or "storage: symlink": the restore then marks the cache stale, for the other projects -->
      <!-- a group without NuGet packages, or whose packages all have "storage: none", only makes it restore on every build -->
      <_PaketLockFileContents Condition=" '$(_PaketPackagesFolderExists)' != 'true' ">$([System.IO.File]::ReadAllText('$(PaketLockFilePath)'))</_PaketLockFileContents>
      <PaketRestoreRequired Condition=" '$(_PaketPackagesFolderExists)' != 'true' And $([System.Text.RegularExpressions.Regex]::Matches(`$(_PaketLockFileContents)`, `(?m)^STORAGE: NONE`).Count) != $([MSBuild]::Add($([System.Text.RegularExpressions.Regex]::Matches(`$(_PaketLockFileContents)`, `(?m)^GROUP `).Count), 1)) ">true</PaketRestoreRequired>
      <PaketRestoreRequired Condition=" '$(_PaketPackagesFolderExists)' != 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch(`$(_PaketLockFileContents)`, `storage: (packages|symlink)`)) ">true</PaketRestoreRequired>
    </PropertyGroup>

    <Exec Command="$(RestoreCommand)"
          IgnoreStandardErrorWarningFormat="true"
          WorkingDirectory="$(PaketRootPath)"
          ContinueOnError="false"
          Condition=" '$(PaketRestoreRequired)' == 'true' AND Exists('$(PaketReferences)') AND '$(PaketReferences)' != '' "
    />
  </Target>
</Project>