source https://api.nuget.org/v3/index.json

storage: none
content: none
# net10.0 for Paket.Core, the CLI and the tests, netstandard2.0 for FSharp.DependencyManager.Paket,
# net461 for Paket.LegacyStub
framework: net10.0, netstandard2.0, net461

nuget Newtonsoft.Json >= 10.0.3 redirects: force
nuget Argu >= 5.1.0
# FSharp.DependencyManager.Paket runs inside fsi, which loads its own FSharp.Core: a newer one
# than the fsi of the SDK, e.g. 11.0 for the 10.1 of SDK 10.0.400, would keep it from loading
nuget FSharp.Core >= 6.0.3 < 10
nuget Chessie >= 0.6
nuget Mono.Cecil ~> 0.11.1

nuget System.Security.Cryptography.ProtectedData >= 4.4

nuget System.Net.Http.WinHttpHandler >= 4.5
nuget Nuget.Packaging

# these two are not public dependencies, they're used for build-time only
# therefore, treat them as private.
nuget Microsoft.NETFramework.ReferenceAssemblies.net461 copy_local: true
nuget DotNet.ReproducibleBuilds copy_local: true

# tests
nuget FSCheck ~> 2.15
nuget FSharp.Compiler.Service

nuget NUnit ~> 3.12.0
nuget NUnit3TestAdapter ~> 3.13.0
nuget Microsoft.NET.Test.Sdk ~> 16.2.0

nuget Fake.Core.ReleaseNotes ~> 5.20.4

github fsharp/FAKE:0341a2e614eb2a7f34607cec914eb0ed83ce9add src/app/FakeLib/Globbing/Globbing.fs
github fsprojects/FSharp.TypeProviders.SDK:dc5ac01a1ac288eceb1fd6f12a5d388236f4f8e5 src/AssemblyReader.fs
github forki/FsUnit FsUnit.fs

group Build
  content: none
  framework >= net461
  source https://api.nuget.org/v3/index.json
  source https://ci.appveyor.com/nuget/fsharp-formatting

  nuget FAKE < 5
  nuget FSharp.Formatting prerelease
  nuget System.ValueTuple
  nuget Microsoft.AspNet.Razor

  github fsharp/FAKE modules/Octokit/Octokit.fsx

# The modules build.fsx is written against. They are loaded through the scripts that
# `paket generate-load-scripts` writes to .paket/load/net10.0/BuildScript/, so this group has to
# resolve for the framework `dotnet fsi` runs on, not for the net461 of the Build group.
#
# `generate_load_scripts: true` is deliberately not used here: the restore would then generate one
# folder per framework represented by *all* the groups of the lock file, and the main group carries
# no restriction at all.
group BuildScript
  content: none
  framework: net10.0
  source https://api.nuget.org/v3/index.json

  nuget Fake.Core.Target 6.1.4
  nuget Fake.Core.ReleaseNotes 6.1.4
  nuget Fake.Core.UserInput 6.1.4
  nuget Fake.IO.FileSystem 6.1.4
  nuget Fake.DotNet.Cli 6.1.4
  nuget Fake.DotNet.Paket 6.1.4
  nuget Fake.Tools.Git 6.1.4